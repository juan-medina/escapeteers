[gd_scene format=3]

[ext_resource type="Script" path="res://codex_panel/codex_panel.gd" id="1_panel"]
[ext_resource type="FontFile" uid="uid://bg6arvysy4jwv" path="res://data/assets/pixel_ui_theme/m6x11plus.ttf" id="2_m6x11plus"]
[ext_resource type="PackedScene" path="res://codex_panel/unread_badge.tscn" id="3_badge"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="CodexPanel" type="PanelContainer" node_paths=PackedStringArray("first_focus", "back_button")]
script = ExtResource("1_panel")
first_focus = NodePath("VBox/ButtonsVBox/Heroes")
back_button = NodePath("VBox/ButtonsVBox/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_m6x11plus")
theme_override_font_sizes/font_size = 18
text = "Codex"
horizontal_alignment = 1

[node name="ButtonsVBox" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Heroes" type="Button" parent="VBox/ButtonsVBox"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Heroes"

[node name="UnreadBadge" parent="VBox/ButtonsVBox/Heroes" instance=ExtResource("3_badge")]
layout_mode = 1

[node name="Enemies" type="Button" parent="VBox/ButtonsVBox"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Enemies"

[node name="UnreadBadge" parent="VBox/ButtonsVBox/Enemies" instance=ExtResource("3_badge")]
layout_mode = 1

[node name="Mechanics" type="Button" parent="VBox/ButtonsVBox"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Mechanics"

[node name="HSeparator" type="HSeparator" parent="VBox/ButtonsVBox"]
layout_mode = 2

[node name="Back" type="Button" parent="VBox/ButtonsVBox" groups=["ui_return"]]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
shortcut = SubResource("Shortcut_back")
text = "Back"

[connection signal="pressed" from="VBox/ButtonsVBox/Heroes" to="." method="_on_heroes_pressed"]
[connection signal="pressed" from="VBox/ButtonsVBox/Enemies" to="." method="_on_enemies_pressed"]
[connection signal="pressed" from="VBox/ButtonsVBox/Mechanics" to="." method="_on_mechanics_pressed"]
[connection signal="pressed" from="VBox/ButtonsVBox/Back" to="." method="_on_back_pressed"]
