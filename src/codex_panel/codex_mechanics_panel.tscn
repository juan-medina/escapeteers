[gd_scene format=3]

[ext_resource type="Script" path="res://codex_panel/codex_mechanics_panel.gd" id="1_panel"]
[ext_resource type="FontFile" uid="uid://bg6arvysy4jwv" path="res://data/assets/pixel_ui_theme/m6x11plus.ttf" id="2_m6x11plus"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="CodexMechanicsPanel" type="PanelContainer" node_paths=PackedStringArray("first_focus", "back_button")]
script = ExtResource("1_panel")
first_focus = NodePath("VBox/ContentRow/TopicsVBox/StatusEffects")
back_button = NodePath("VBox/Buttons/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_m6x11plus")
theme_override_font_sizes/font_size = 18
text = "Codex - Mechanics"
horizontal_alignment = 1

[node name="ContentRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TopicsVBox" type="VBoxContainer" parent="VBox/ContentRow"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="StatusEffects" type="Button" parent="VBox/ContentRow/TopicsVBox"]
custom_minimum_size = Vector2(142, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../../../Buttons/Back")
focus_neighbor_bottom = NodePath("../Formation")
text = "Status Effects"

[node name="Formation" type="Button" parent="VBox/ContentRow/TopicsVBox"]
custom_minimum_size = Vector2(142, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../StatusEffects")
focus_neighbor_bottom = NodePath("../SquadLeveling")
text = "Formation"

[node name="SquadLeveling" type="Button" parent="VBox/ContentRow/TopicsVBox"]
custom_minimum_size = Vector2(142, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../Formation")
focus_neighbor_bottom = NodePath("../KeysTraps")
text = "Squad & Leveling"

[node name="KeysTraps" type="Button" parent="VBox/ContentRow/TopicsVBox"]
custom_minimum_size = Vector2(142, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../SquadLeveling")
focus_neighbor_bottom = NodePath("../../../Buttons/Back")
text = "Keys & Traps"

[node name="DetailPanel" type="PanelContainer" parent="VBox/ContentRow"]
layout_mode = 2

[node name="DetailText" type="RichTextLabel" parent="VBox/ContentRow/DetailPanel"]
custom_minimum_size = Vector2(400, 212)
layout_mode = 2
bbcode_enabled = true

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="VBox/Buttons" groups=["ui_return"]]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../../ContentRow/TopicsVBox/StatusEffects")
focus_neighbor_bottom = NodePath("../../ContentRow/TopicsVBox/StatusEffects")
shortcut = SubResource("Shortcut_back")
text = "Back"

[connection signal="focus_entered" from="VBox/ContentRow/TopicsVBox/StatusEffects" to="." method="_on_status_effects_inspected"]
[connection signal="mouse_entered" from="VBox/ContentRow/TopicsVBox/StatusEffects" to="." method="_on_status_effects_inspected"]
[connection signal="pressed" from="VBox/ContentRow/TopicsVBox/StatusEffects" to="." method="_on_status_effects_inspected"]
[connection signal="focus_entered" from="VBox/ContentRow/TopicsVBox/Formation" to="." method="_on_formation_inspected"]
[connection signal="mouse_entered" from="VBox/ContentRow/TopicsVBox/Formation" to="." method="_on_formation_inspected"]
[connection signal="pressed" from="VBox/ContentRow/TopicsVBox/Formation" to="." method="_on_formation_inspected"]
[connection signal="focus_entered" from="VBox/ContentRow/TopicsVBox/SquadLeveling" to="." method="_on_squad_leveling_inspected"]
[connection signal="mouse_entered" from="VBox/ContentRow/TopicsVBox/SquadLeveling" to="." method="_on_squad_leveling_inspected"]
[connection signal="pressed" from="VBox/ContentRow/TopicsVBox/SquadLeveling" to="." method="_on_squad_leveling_inspected"]
[connection signal="focus_entered" from="VBox/ContentRow/TopicsVBox/KeysTraps" to="." method="_on_keys_traps_inspected"]
[connection signal="mouse_entered" from="VBox/ContentRow/TopicsVBox/KeysTraps" to="." method="_on_keys_traps_inspected"]
[connection signal="pressed" from="VBox/ContentRow/TopicsVBox/KeysTraps" to="." method="_on_keys_traps_inspected"]
[connection signal="pressed" from="VBox/Buttons/Back" to="." method="_on_back_pressed"]
