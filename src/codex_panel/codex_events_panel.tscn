[gd_scene format=3]

[ext_resource type="Script" path="res://codex_panel/codex_events_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://codex_panel/codex_entry_card.tscn" id="2_card"]
[ext_resource type="PackedScene" path="res://codex_panel/codex_details_panel.tscn" id="3_details"]
[ext_resource type="FontFile" uid="uid://bg6arvysy4jwv" path="res://data/assets/pixel_ui_theme/m6x11plus.ttf" id="4_m6x11plus"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="CodexEventsPanel" type="PanelContainer" node_paths=PackedStringArray("cards_container", "details_panel", "first_focus", "back_button")]
script = ExtResource("1_panel")
cards_container = NodePath("VBox/CardsRow")
details_panel = NodePath("VBox/CodexDetailsPanel")
first_focus = NodePath("VBox/CardsRow/Card1")
back_button = NodePath("VBox/Buttons/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_m6x11plus")
theme_override_font_sizes/font_size = 18
text = "Codex - Events"
horizontal_alignment = 1

[node name="CardsRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8
alignment = 1

[node name="Card1" parent="VBox/CardsRow" instance=ExtResource("2_card")]
custom_minimum_size = Vector2(132, 48)
layout_mode = 2
focus_neighbor_left = NodePath("../Card4")
focus_neighbor_right = NodePath("../Card2")
focus_neighbor_bottom = NodePath("../../Buttons/Back")
entry_id = &"closing_spikes"

[node name="Card2" parent="VBox/CardsRow" instance=ExtResource("2_card")]
custom_minimum_size = Vector2(132, 48)
layout_mode = 2
focus_neighbor_left = NodePath("../Card1")
focus_neighbor_right = NodePath("../Card3")
focus_neighbor_bottom = NodePath("../../Buttons/Back")
entry_id = &"wave_ambush"

[node name="Card3" parent="VBox/CardsRow" instance=ExtResource("2_card")]
custom_minimum_size = Vector2(132, 48)
layout_mode = 2
focus_neighbor_left = NodePath("../Card2")
focus_neighbor_right = NodePath("../Card4")
focus_neighbor_bottom = NodePath("../../Buttons/Back")
entry_id = &"cursed_obelisks"

[node name="Card4" parent="VBox/CardsRow" instance=ExtResource("2_card")]
custom_minimum_size = Vector2(132, 48)
layout_mode = 2
focus_neighbor_left = NodePath("../Card3")
focus_neighbor_right = NodePath("../Card1")
focus_neighbor_bottom = NodePath("../../Buttons/Back")
entry_id = &"rune_plates"

[node name="CodexDetailsPanel" parent="VBox" instance=ExtResource("3_details")]
custom_minimum_size = Vector2(552, 184)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="VBox/Buttons" groups=["ui_return"]]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../../CardsRow/Card1")
shortcut = SubResource("Shortcut_back")
text = "Back"

[connection signal="inspected" from="VBox/CardsRow/Card1" to="." method="_on_card_inspected"]
[connection signal="inspected" from="VBox/CardsRow/Card2" to="." method="_on_card_inspected"]
[connection signal="inspected" from="VBox/CardsRow/Card3" to="." method="_on_card_inspected"]
[connection signal="inspected" from="VBox/CardsRow/Card4" to="." method="_on_card_inspected"]
[connection signal="pressed" from="VBox/Buttons/Back" to="." method="_on_back_pressed"]
