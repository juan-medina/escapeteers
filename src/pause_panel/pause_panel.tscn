[gd_scene format=3]

[ext_resource type="Script" path="res://pause_panel/pause_panel.gd" id="1_jp402"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="PausePanel" type="PanelContainer"]
script = ExtResource("1_jp402")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Pause"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="VBox" groups=["ui_return"]]
layout_mode = 2
shortcut = SubResource("Shortcut_back")
text = "Resume"

[node name="Settings" type="Button" parent="VBox"]
layout_mode = 2
text = "Settings"

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="BackToMenu" type="Button" parent="VBox"]
layout_mode = 2
text = "Back to Menu"

[connection signal="pressed" from="VBox/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="VBox/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="VBox/BackToMenu" to="." method="_on_back_to_menu_pressed"]
