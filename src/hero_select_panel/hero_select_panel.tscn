[gd_scene format=3]

[ext_resource type="Script" path="res://hero_select_panel/hero_select_panel.gd" id="1_panel"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="HeroSelectPanel" type="PanelContainer" node_paths=PackedStringArray("first_focus")]
script = ExtResource("1_panel")
first_focus = NodePath("VBox/Buttons/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
text = "Choose Your Hero"
horizontal_alignment = 1

[node name="GridMargin" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_right = 6

[node name="Grid" type="GridContainer" parent="VBox/GridMargin"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="VBox/Buttons" groups=["ui_return"]]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
shortcut = SubResource("Shortcut_back")
text = "Back"

[connection signal="pressed" from="VBox/Buttons/Back" to="." method="_on_back_pressed"]

