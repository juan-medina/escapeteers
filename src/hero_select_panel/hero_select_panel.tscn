[gd_scene format=3]

[ext_resource type="Script" path="res://hero_select_panel/hero_select_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://hero_select_panel/hero_select_card.tscn" id="2_card"]
[ext_resource type="FontFile" uid="uid://bg6arvysy4jwv" path="res://data/assets/pixel_ui_theme/m6x11plus.ttf" id="3_m6x11plus"]
[ext_resource type="PackedScene" path="res://codex_panel/unread_badge.tscn" id="4_badge"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="HeroSelectPanel" type="PanelContainer" node_paths=PackedStringArray("first_focus", "back_button")]
script = ExtResource("1_panel")
first_focus = NodePath("VBox/GridMargin/Grid/Card1")
back_button = NodePath("VBox/Buttons/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_m6x11plus")
theme_override_font_sizes/font_size = 18
text = "Choose Your Hero"
horizontal_alignment = 1

[node name="GridMargin" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_right = 6

[node name="Grid" type="GridContainer" parent="VBox/GridMargin"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="Card1" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
hero_id = &"armored_axeman"

[node name="Card2" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
hero_id = &"knight"

[node name="Card3" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
hero_id = &"knight_templar"

[node name="Card4" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
hero_id = &"swordsman"

[node name="Card5" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
focus_neighbor_bottom = NodePath("../../../Buttons/Back")
hero_id = &"archer"

[node name="Card6" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
focus_neighbor_bottom = NodePath("../../../Buttons/Back")
hero_id = &"wizard"

[node name="Card7" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
focus_neighbor_bottom = NodePath("../../../Buttons/Codex")
hero_id = &"priest"

[node name="Card8" parent="VBox/GridMargin/Grid" instance=ExtResource("2_card")]
layout_mode = 2
focus_neighbor_bottom = NodePath("../../../Buttons/Codex")
hero_id = &"soldier"

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="VBox/Buttons" groups=["ui_return"]]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
focus_neighbor_top = NodePath("../../GridMargin/Grid/Card6")
focus_neighbor_right = NodePath("../Codex")
shortcut = SubResource("Shortcut_back")
text = "Back"

[node name="Codex" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
focus_neighbor_left = NodePath("../Back")
focus_neighbor_top = NodePath("../../GridMargin/Grid/Card7")
text = "Codex"

[node name="UnreadBadge" parent="VBox/Buttons/Codex" instance=ExtResource("4_badge")]
layout_mode = 1

[connection signal="chosen" from="VBox/GridMargin/Grid/Card1" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card2" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card3" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card4" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card5" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card6" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card7" to="." method="_on_card_chosen"]
[connection signal="chosen" from="VBox/GridMargin/Grid/Card8" to="." method="_on_card_chosen"]
[connection signal="pressed" from="VBox/Buttons/Back" to="." method="_on_back_pressed"]
[connection signal="pressed" from="VBox/Buttons/Codex" to="." method="_on_codex_pressed"]
