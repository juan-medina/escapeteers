[gd_scene format=3]

[ext_resource type="Script" path="res://settings_panel/volume_slider.gd" id="1_slider"]

[node name="VolumeSlider" type="MarginContainer"]
theme_override_constants/margin_left = 6
script = ExtResource("1_slider")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Label" type="Label" parent="VBox"]
layout_mode = 2

[node name="HBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="HSlider" type="HSlider" parent="VBox/HBox"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
max_value = 1.0
step = 0.05
value = 0.5

[node name="Percent" type="Label" parent="VBox/HBox"]
custom_minimum_size = Vector2(30, 0)
layout_mode = 2
text = "50 %"
horizontal_alignment = 2

[connection signal="value_changed" from="VBox/HBox/HSlider" to="." method="_on_slider_value_changed"]

