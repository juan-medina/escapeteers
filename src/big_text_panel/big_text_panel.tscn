[gd_scene format=3]

[ext_resource type="Script" path="res://big_text_panel/big_text_panel.gd" id="1_bigtext"]

[sub_resource type="InputEventAction" id="InputEventAction_pause"]
device = -1
action = &"pause"

[sub_resource type="InputEventAction" id="InputEventAction_back"]
device = -1
action = &"back"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_pause"), SubResource("InputEventAction_back")]

[node name="BigTextPanel" type="PanelContainer" node_paths=PackedStringArray("first_focus", "back_button")]
script = ExtResource("1_bigtext")
first_focus = NodePath("VBox/Buttons/Back")
back_button = NodePath("VBox/Buttons/Back")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="Text" type="RichTextLabel" parent="VBox"]
custom_minimum_size = Vector2(550, 250)
layout_mode = 2
bbcode_enabled = true

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="VBox/Buttons" groups=["ui_return"]]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
shortcut = SubResource("Shortcut_back")
text = "Back"

[connection signal="meta_clicked" from="VBox/Text" to="." method="_on_meta_clicked"]
[connection signal="pressed" from="VBox/Buttons/Back" to="." method="_on_back_pressed"]

