[node name="MenuOverlay" type="CanvasLayer"]
script = ExtResource("1_g18jx")

[node name="ColorRect" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.05, 1)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainMenuPanel" parent="Center" instance=ExtResource("2_main")]
layout_mode = 2

[node name="HeroSelectPanel" parent="Center" instance=ExtResource("3_hero_select")]
visible = false
layout_mode = 2

[node name="SettingsPanel" parent="Center" instance=ExtResource("4_settings")]
visible = false
layout_mode = 2

[node name="AboutPanel" parent="Center" instance=ExtResource("5_about")]
visible = false
layout_mode = 2

[connection signal="about_requested" from="Center/MainMenuPanel" to="." method="_on_about_requested"]
[connection signal="exit_requested" from="Center/MainMenuPanel" to="." method="_on_exit_requested"]
