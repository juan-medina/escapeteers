[gd_scene format=3]

[ext_resource type="Script" path="res://menu/menu.gd" id="1_g18jx"]
[ext_resource type="PackedScene" path="res://main_menu_panel/main_menu_panel.tscn" id="2_main"]
[ext_resource type="PackedScene" path="res://hero_select_panel/hero_select_panel.tscn" id="3_hero_select"]
