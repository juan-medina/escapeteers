[gd_scene format=3]

[ext_resource type="PackedScene" path="res://big_text_panel/big_text_panel.tscn" id="1_base"]
[ext_resource type="Script" path="res://about_panel/about_panel.gd" id="2_about"]

[node name="AboutPanel" instance=ExtResource("1_base")]
script = ExtResource("2_about")
title = "About"
text_file = "res://about_panel/about.txt"

[node name="License" type="Button" parent="VBox/Buttons" index="1"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "License"

[node name="Website" type="Button" parent="VBox/Buttons" index="2"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "Website"

[connection signal="pressed" from="VBox/Buttons/License" to="." method="_on_license_pressed"]
[connection signal="pressed" from="VBox/Buttons/Website" to="." method="_on_website_pressed"]
